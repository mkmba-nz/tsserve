# Copy to .env in this directory and fill in.
#
# Tailscale auth key tagged with tag:tsserve. Short-TTL ephemeral key is fine.
TS_AUTHKEY=tskey-auth-CHANGEME

# Your tailnet's MagicDNS suffix (e.g. tailABCD.ts.net). The smoke script uses
# this to build URLs like https://tsserve-test-web.${TAILNET_SUFFIX}.
TAILNET_SUFFIX=tailXXXX.ts.net

# Optional overrides:
# TSSERVE_HOSTNAME=tsserve-tier2
# TSSERVE_LOG_LEVEL=info
# HOST_METRICS_PORT=9090

# --- Node-identity header validation (optional) ------------------------------
# To exercise the Tailscale-Node-Tags / Tailscale-Node-Name headers, provide a
# SECOND auth key that is TAGGED (e.g. tag:tsserve). When set, the smoke script
# starts a tagged Tailscale client and curls svc:tsserve-test-caps through it.
# Leave unset to skip the tagged-peer checks.
#
# The client's tag must be granted access to svc:tsserve-test-caps in your ACLs.
# TS_CLIENT_AUTHKEY=tskey-auth-CHANGEME-tagged
#
# Stripped tag value to assert in the Tailscale-Node-Tags header (the part after
# "tag:"). Must match a tag carried by TS_CLIENT_AUTHKEY. Default: tsserve.
# CLIENT_NODE_TAG=tsserve
#
# Hostname for the tagged client node; appears in Tailscale-Node-Name.
# CLIENT_HOSTNAME=tsserve-tier2-client
