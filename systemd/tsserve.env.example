# tsserve configuration. Read by systemd via EnvironmentFile=.
# Lines starting with # are ignored. Values are NOT shell-evaluated; use plain
# strings without surrounding quotes.
#
# This file documents every supported variable. Uncomment and set the ones you
# need. See SPEC.md for full documentation.

# --- Authentication (pick exactly one mode) -------------------------------

# Mode 1: Workload Identity Federation (recommended). Zero static credentials.
# Configure a federated identity in the Tailscale admin console trusting your
# AWS account's IAM, and the EC2 instance role's identity is exchanged for a
# short-lived Tailscale key at startup.
#TS_CLIENT_ID=
#TS_AUDIENCE=
#TSSERVE_TAGS=tag:tsserve

# Mode 2: OAuth client. Long-lived credential, requires a secret.
#TS_CLIENT_ID=
#TS_CLIENT_SECRET=
#TSSERVE_TAGS=tag:tsserve

# Mode 3: Auth key. Simplest, but a long-lived secret. Prefer Mode 1 in
# production.
#TS_AUTHKEY=tskey-auth-...

# --- Discovery ------------------------------------------------------------

# One or more discovery modes, comma-separated. 'docker' (default) reads
# /var/run/docker.sock. 'ecs' polls the AWS ECS API. 'lambda' polls the AWS
# Tagging API for Lambda functions tagged tsserve.enable=true. Every listed
# mode runs in this one process; each mode's variables below are read only
# when it is listed.
#TSSERVE_DISCOVERY=ecs,lambda

# Region for the ECS and Lambda readers. Required when ecs or lambda is
# listed, unless every account entry sets its own region.
#AWS_REGION=us-east-1

# Required when TSSERVE_DISCOVERY includes ecs.
#TSSERVE_ECS_CLUSTER=prod-apps

# Go duration. Default 10s. Raise for clusters >1000 tasks.
#TSSERVE_ECS_POLL_INTERVAL=30s

# Shared-config profile / file used ONLY by the ECS discovery client.
# Set these (instead of AWS_PROFILE / AWS_CONFIG_FILE) when ECS lives in
# a different account from this host: a process-wide AWS_PROFILE also
# pulls tsnet's WIF auth flow onto the assumed role, which usually breaks
# the OIDC trust Tailscale has on the host's default (instance) role.
#TSSERVE_ECS_AWS_PROFILE=ecs-reader
#TSSERVE_ECS_AWS_CONFIG_FILE=/etc/aws/config

# Multi-account discovery. A JSON array of accounts, each watched by its own
# poller with its own credential context. When set, tsserve builds one watcher
# per entry; when unset it watches the single account described by the vars
# above (backward compatible). Per-entry fields are all optional and fall back
# to the shared vars above: name (defaults to the AWS account id resolved via
# sts:GetCallerIdentity), cluster (TSSERVE_ECS_CLUSTER), region (AWS_REGION),
# profile (TSSERVE_ECS_AWS_PROFILE), configFile (TSSERVE_ECS_AWS_CONFIG_FILE),
# and accessKeyID + secretAccessKey (static creds, set both or neither).
# Must be a single line (systemd EnvironmentFile does not join wrapped lines).
#TSSERVE_ECS_ACCOUNTS=[{"profile":"ecs-reader-111","cluster":"infra"},{"profile":"ecs-reader-222","cluster":"ocopt-front"}]

# --- Lambda discovery (TSSERVE_DISCOVERY includes lambda) -----------------

# Go duration. Default 30s. Each poll costs one Tagging API call per 100
# tagged functions.
#TSSERVE_LAMBDA_POLL_INTERVAL=30s

# Go duration. Default 2m. Slower cadence for a reader whose polls are
# failing (e.g. a role not assumable yet). Never faster than the poll interval.
#TSSERVE_LAMBDA_RETRY_INTERVAL=2m

# Shared-config profile / file used ONLY by the Lambda readers' clients:
# Tagging and STS for discovery, and the Lambda client that invokes functions. Set
# these instead of AWS_PROFILE / AWS_CONFIG_FILE, for the same reason as the
# ECS ones above. The principal needs tag:GetResources and
# lambda:InvokeFunction on the functions (and their qualified ARNs when
# tsserve.qualifier is used).
#TSSERVE_LAMBDA_AWS_PROFILE=fn-reader
#TSSERVE_LAMBDA_AWS_CONFIG_FILE=/etc/aws/config

# Multi-account / multi-region discovery. A JSON array, one Lambda reader per
# entry; unset, one reader uses the vars above. Same fields as
# TSSERVE_ECS_ACCOUNTS minus cluster: name (defaults to the AWS account id
# resolved via sts:GetCallerIdentity), region (AWS_REGION), profile
# (TSSERVE_LAMBDA_AWS_PROFILE), configFile (TSSERVE_LAMBDA_AWS_CONFIG_FILE),
# and accessKeyID + secretAccessKey (set both or neither). A reader covers one
# region: entries for one account in several regions need explicit, distinct
# names. Must be a single line.
#TSSERVE_LAMBDA_ACCOUNTS=[{"profile":"fn-reader-111"},{"name":"222-use1","profile":"fn-reader-222","region":"us-east-1"},{"name":"222-apse2","profile":"fn-reader-222","region":"ap-southeast-2"}]

# --- General --------------------------------------------------------------

# Hostname this node advertises on the tailnet.
#TSSERVE_HOSTNAME=tsserve

# Persisted under /var/lib/tsserve by systemd's StateDirectory=. Do not
# change unless you know what you're doing.
#TSSERVE_STATE_DIR=/var/lib/tsserve

# debug | info (default) | warn | error
#TSSERVE_LOG_LEVEL=info

# --- Observability --------------------------------------------------------

# host:port for the loopback HTTP listener serving /metrics for Prometheus.
# Default 127.0.0.1:9090. Set to "" to disable, or 0.0.0.0:9100 to expose to
# a remote scraper (host firewall enforcement is then your responsibility).
#TSSERVE_METRICS_ADDR=127.0.0.1:9090

# If set, the tailnet HTTPS listener proxies /traefik to http://localhost:<port>
# Useful when tsserve runs on a gateway alongside Traefik.
#TSSERVE_TRAEFIK_PORT=8080
